class ContinuousChartNet(nn.Module):
    """
    CATO Continuous Coordinate Chart Network:
    Learns a continuous nonlinear mapping phi_chart: R^d -> R^d from raw physical
    coordinates (e.g., x, y) into a smooth, latent chart space (u, v).
    This re-parameterizes the physical geometry to expose low-rank axial alignment.
    """
    def __init__(self, in_dim=2, hidden_dim=32, out_dim=2):
        super().__init__()
        self.chart_mlp = nn.Sequential(
            nn.Linear(in_dim, hidden_dim),
            nn.GELU(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.GELU(),
            nn.Linear(hidden_dim, out_dim)
        )

    def forward(self, coords):
        # coords shape: [N_nodes, 2] or [B, N_nodes, 2]
        chart_coords = self.chart_mlp(coords)
        return chart_coords


class ChartedAxialAttention(nn.Module):
    """
    Charted Axial Attention Module:
    Applies factorized 1D multi-head self-attentions along orthogonal chart directions
    in the learned latent chart space. Conditioned on continuous chart positional encodings.
    """
    def __init__(self, embed_dim, heads=4):
        super().__init__()
        self.embed_dim = embed_dim
        self.heads = heads
        self.head_dim = embed_dim // heads

        assert self.head_dim * heads == embed_dim, "CATO Error: embed_dim must be cleanly divisible by heads count"

        # Positional coordinate projection from latent chart space
        self.chart_pos_proj = nn.Linear(2, embed_dim)

        self.attn_h = AxialMultiHeadAttention(embed_dim, heads=heads)
        self.attn_w = AxialMultiHeadAttention(embed_dim, heads=heads)
        self.fuse_proj = nn.Linear(embed_dim * 2, embed_dim)
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, x, chart_coords):
        # x shape: [B, H, W, C]
        # chart_coords shape: [N_nodes, 2] where N_nodes = H * W
        B, H, W, C = x.shape
        N_nodes = H * W

        # 1. Project latent continuous chart coordinates into positional embeddings
        chart_pos_emb = self.chart_pos_proj(chart_coords) # [N_nodes, C]
        chart_pos_emb = chart_pos_emb.view(1, H, W, C)      # [1, H, W, C]

        # 2. Inject continuous chart position signals into feature map
        x_charted = x + chart_pos_emb # [B, H, W, C]

        # 3. Compute factorized axial attentions along chart axes
        out_h = self.attn_h(x_charted, axis=1) # [B, H, W, C]
        out_w = self.attn_w(x_charted, axis=2) # [B, H, W, C]

        # 4. Fuse chart-conditioned spatial features
        fused = torch.cat([out_h, out_w], dim=-1) # [B, H, W, 2*C]
        out = self.norm(x + self.fuse_proj(fused))

        assert out.shape == (B, H, W, C), f"Charted Axial Attention Output Error: {list(out.shape)}"
        return out


class CATOBlock(nn.Module):
    """
    CATO Transformer Block:
    Integrates Charted Axial Attention with a pointwise Feed-Forward Network.
    """
    def __init__(self, embed_dim, heads=4):
        super().__init__()
        self.charted_attn = ChartedAxialAttention(embed_dim, heads=heads)
        self.ffn = nn.Sequential(
            nn.Linear(embed_dim, embed_dim * 2),
            nn.GELU(),
            nn.Linear(embed_dim * 2, embed_dim)
        )
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, x, chart_coords):
        attn_out = self.charted_attn(x, chart_coords)
        ffn_out = self.ffn(attn_out)
        out = self.norm(attn_out + ffn_out)
        return out


class CATONet(nn.Module):
    """
    Charted Axial Transformer Operator (CATO):
    Learns a continuous coordinate chart phi_chart to map physical mesh points into a
    latent chart space, then executes chart-conditioned axial attention for fast PDE operator learning.
    """
    def __init__(self, node_in_channels=1, hidden_channels=64, out_channels=1, num_layers=3, heads=4):
        super().__init__()
        self.hidden_channels = hidden_channels
        self.heads = heads

        # Continuous latent geometry chart generator
        self.chart_net = ContinuousChartNet(in_dim=2, hidden_dim=32, out_dim=2)

        # Scalar field lifting layer
        self.lifting = nn.Linear(node_in_channels, hidden_channels)

        # Cascaded CATO blocks
        self.layers = nn.ModuleList([
            CATOBlock(embed_dim=hidden_channels, heads=heads)
            for _ in range(num_layers)
        ])

        self.projection = nn.Sequential(
            nn.Linear(hidden_channels, hidden_channels),
            nn.GELU(),
            nn.Linear(hidden_channels, out_channels)
        )

    def forward(self, inputs):
        assert isinstance(inputs, (tuple, list)) and len(inputs) == 2, \
            "CATONet Error: Inputs must be formatted as (x_branch, x_trunk)"

        x_branch, x_trunk = inputs

        if isinstance(x_branch, np.ndarray): x_branch = torch.from_numpy(x_branch).float()
        if isinstance(x_trunk, np.ndarray): x_trunk = torch.from_numpy(x_trunk).float()

        device = next(self.parameters()).device
        x_branch = x_branch.to(device)
        x_trunk = x_trunk.to(device)

        B = x_branch.shape[0]
        N_nodes = x_trunk.shape[0]

        # Deduce grid spatial resolution H x W from total node sequence count
        H = int(np.round(np.sqrt(N_nodes)))
        W = H

        assert H * W == N_nodes, f"CATO Resolution Error: N_nodes={N_nodes} is not a perfect square grid ({H}x{W})"

        # 1. Map raw physical spatial coordinates x_trunk -> latent continuous chart coordinates
        chart_coords = self.chart_net(x_trunk) # [N_nodes, 2]

        # Sanity Check 1: Verify chart coordinate tensor dimensions
        assert chart_coords.shape == (N_nodes, 2), f"Chart Mapping Error: Got shape {list(chart_coords.shape)}"

        # 2. Lift input scalar field values to embedded hidden channels
        h = self.lifting(x_branch.unsqueeze(-1)) # [B, N_nodes, hidden_channels]

        # Reshape to 2D grid matrix representation layout for axial chart attention
        h_grid = h.view(B, H, W, self.hidden_channels)

        # 3. Process features through Charted Axial Attention blocks
        for layer in self.layers:
            h_grid = layer(h_grid, chart_coords)

        # Sanity Check 2: Confirm grid matrix shape preservation
        assert h_grid.shape == (B, H, W, self.hidden_channels), f"CATO Layer Processing Error: {list(h_grid.shape)}"

        # Flatten spatial grid matrix back to 1D sequence layout
        h_flat = h_grid.view(B, N_nodes, self.hidden_channels)

        # 4. Project hidden representations back to predicted PDE output fields
        out = self.projection(h_flat).squeeze(-1) # [B, N_nodes]

        # Final Verification Check: Confirm output tensor shape matches ground truth target
        assert out.shape == (B, N_nodes), f"CATO Final Output Error: Shape mismatch {list(out.shape)}"
        return out

