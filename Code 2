class PhysicsSliceAttention(nn.Module):
    """
    Transolver Physics-Attention Module:
    1. Projects spatial mesh tokens into K learnable physical slices (subdomains).
    2. Performs multi-head self-attention strictly across the K slices O(K^2).
    3. Maps transformed slice representations back to the N spatial mesh points O(N*K).
    Achieves linear O(N) memory complexity with zero reliance on regular tensor grids.
    """
    def __init__(self, embed_dim, num_slices=8, heads=4):
        super().__init__()
        self.embed_dim = embed_dim
        self.num_slices = num_slices
        self.heads = heads
        self.head_dim = embed_dim // heads

        assert self.head_dim * heads == embed_dim, "Transolver Error: embed_dim must be cleanly divisible by heads count"

        # Physical Slice Assignment Network: Maps N mesh points to K soft slice weights
        self.slice_proj = nn.Sequential(
            nn.Linear(embed_dim, embed_dim),
            nn.GELU(),
            nn.Linear(embed_dim, num_slices)
        )

        # Inter-slice multi-head attention components
        self.q_proj = nn.Linear(embed_dim, embed_dim)
        self.k_proj = nn.Linear(embed_dim, embed_dim)
        self.v_proj = nn.Linear(embed_dim, embed_dim)
        self.out_proj = nn.Linear(embed_dim, embed_dim)
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, x):
        B, N, C = x.shape
        K = self.num_slices
        H = self.heads
        D = self.head_dim

        # 1. Compute soft physical slice assignments S: [B, N, K]
        # Softmax over spatial dimension N normalizes point contributions across each slice
        slice_logits = self.slice_proj(x) # [B, N, K]
        S = F.softmax(slice_logits, dim=-2)

        # Sanity Check 1: Verify slice assignment matrix structure
        assert S.shape == (B, N, K), f"Slice Assignment Error: Got shape {list(S.shape)}"

        # 2. Slice Aggregation: Compress N spatial tokens into K global physical slice states Z
        # S is [B, N, K], x is [B, N, C] -> Z = S^T @ x -> [B, K, C]
        Z = torch.bmm(S.transpose(1, 2), x) # [B, K, C]

        # Sanity Check 2: Confirm physical slice feature matrix aggregation
        assert Z.shape == (B, K, C), f"Slice Aggregation Error: Got shape {list(Z.shape)}"

        # 3. Inter-Slice Multi-Head Self-Attention: O(K^2) computational cost
        q = self.q_proj(Z).view(B, K, H, D).permute(0, 2, 1, 3) # [B, H, K, D]
        k = self.k_proj(Z).view(B, K, H, D).permute(0, 2, 1, 3) # [B, H, K, D]
        v = self.v_proj(Z).view(B, K, H, D).permute(0, 2, 1, 3) # [B, H, K, D]

        scores = torch.matmul(q, k.transpose(-2, -1)) / (D ** 0.5) # [B, H, K, K]
        attn_weights = F.softmax(scores, dim=-1)

        context = torch.matmul(attn_weights, v) # [B, H, K, D]
        context = context.permute(0, 2, 1, 3).contiguous().view(B, K, C) # [B, K, C]
        Z_attn = self.out_proj(context)

        # 4. De-slicing Projection: Broadcast slice features back to original N mesh nodes
        # S is [B, N, K], Z_attn is [B, K, C] -> x_out = S @ Z_attn -> [B, N, C]
        x_out = torch.bmm(S, Z_attn) # [B, N, C]

        # Sanity Check 3: Check spatial token reconstruction alignment
        assert x_out.shape == (B, N, C), f"De-slicing Error: Got shape {list(x_out.shape)}"

        out = self.norm(x + x_out)
        return out


class TransolverBlock(nn.Module):
    """
    Transolver Transformer Block: Combines Physics Slice-Attention with
    a point-wise Feed-Forward Network and residual normalization.
    """
    def __init__(self, embed_dim, num_slices=8, heads=4):
        super().__init__()
        self.slice_attn = PhysicsSliceAttention(embed_dim, num_slices=num_slices, heads=heads)
        self.ffn = nn.Sequential(
            nn.Linear(embed_dim, embed_dim * 2),
            nn.GELU(),
            nn.Linear(embed_dim * 2, embed_dim)
        )
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, x):
        attn_out = self.slice_attn(x)
        ffn_out = self.ffn(attn_out)
        out = self.norm(attn_out + ffn_out)
        return out


class TransolverNet(nn.Module):
    """
    Transolver Neural Operator Network:
    Uses learnable physical slices to decouple self-attention from mesh resolution,
    enabling efficient linear-time evaluation across structured or unstructured geometries.
    """
    def __init__(self, node_in_channels=1, hidden_channels=64, out_channels=1, num_layers=3, num_slices=8, heads=4):
        super().__init__()
        self.hidden_channels = hidden_channels

        self.lifting = nn.Linear(node_in_channels, hidden_channels)

        self.layers = nn.ModuleList([
            TransolverBlock(embed_dim=hidden_channels, num_slices=num_slices, heads=heads)
            for _ in range(num_layers)
        ])

        self.projection = nn.Sequential(
            nn.Linear(hidden_channels, hidden_channels),
            nn.GELU(),
            nn.Linear(hidden_channels, out_channels)
        )

    def forward(self, inputs):
        assert isinstance(inputs, (tuple, list)) and len(inputs) == 2, \
            "TransolverNet Error: Inputs must be formatted as (x_branch, x_trunk)"

        x_branch, x_trunk = inputs

        if isinstance(x_branch, np.ndarray): x_branch = torch.from_numpy(x_branch).float()
        if isinstance(x_trunk, np.ndarray): x_trunk = torch.from_numpy(x_trunk).float()

        device = next(self.parameters()).device
        x_branch = x_branch.to(device)
        x_trunk = x_trunk.to(device)

        B = x_branch.shape[0]
        N_nodes = x_trunk.shape[0]

        # 1. Map node scalar fields to hidden channel embeddings
        h = self.lifting(x_branch.unsqueeze(-1)) # [B, N_nodes, hidden_channels]

        # Sanity Check 1: Verify lifting feature dimensions
        assert h.shape == (B, N_nodes, self.hidden_channels), f"Lifting Error: Got shape {list(h.shape)}"

        # 2. Pass sequence through Transolver Physics Slice-Attention layers
        for layer in self.layers:
            h = layer(h)

        # Sanity Check 2: Verify feature shape stability across deep layers
        assert h.shape == (B, N_nodes, self.hidden_channels), f"Transolver Layer Processing Error: {list(h.shape)}"

        # 3. Project hidden representations to predicted PDE scalar field
        out = self.projection(h).squeeze(-1) # [B, N_nodes]

        # Final Sanity Check: Confirm batch dimension alignment matches target output
        assert out.shape == (B, N_nodes), f"Transolver Final Output Error: Shape mismatch {list(out.shape)}"
        return out

