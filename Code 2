class KernelizedLinearAttention(nn.Module):
    """
    LinearNO Kernelized Attention Module:
    Replaces standard softmax attention O(N^2) with positive feature map kernels phi(Q) and phi(K).

    By exploiting matrix associativity:
      (phi(Q) @ phi(K)^T) @ V  ==  phi(Q) @ (phi(K)^T @ V)

    This reduces computational and memory complexity strictly to linear O(N * d^2)
    without needing spatial grid slicing or factorized tensor dimensions.
    """
    def __init__(self, embed_dim, heads=4, eps=1e-6):
        super().__init__()
        self.embed_dim = embed_dim
        self.heads = heads
        self.head_dim = embed_dim // heads
        self.eps = eps

        assert self.head_dim * heads == embed_dim, "LinearNO Error: embed_dim must be cleanly divisible by heads count"

        self.q_proj = nn.Linear(embed_dim, embed_dim)
        self.k_proj = nn.Linear(embed_dim, embed_dim)
        self.v_proj = nn.Linear(embed_dim, embed_dim)
        self.out_proj = nn.Linear(embed_dim, embed_dim)
        self.norm = nn.LayerNorm(embed_dim)

    def feature_map(self, x):
        # ELU + 1 guarantees non-negativity required for valid probability measure kernel approximation
        return F.elu(x) + 1.0

    def forward(self, x):
        B, N, C = x.shape
        H = self.heads
        D = self.head_dim

        # Project Queries, Keys, and Values: [B, N, C] -> [B, H, N, D]
        q = self.q_proj(x).view(B, N, H, D).permute(0, 2, 1, 3)
        k = self.k_proj(x).view(B, N, H, D).permute(0, 2, 1, 3)
        v = self.v_proj(x).view(B, N, H, D).permute(0, 2, 1, 3)

        # Apply non-negative kernel feature mapping
        q_phi = self.feature_map(q)  # [B, H, N, D]
        k_phi = self.feature_map(k)  # [B, H, N, D]

        # Sanity Check 1: Non-negativity assertion for stability
        assert (q_phi >= 0).all(), "LinearNO Error: Negative feature map values detected in queries"
        assert (k_phi >= 0).all(), "LinearNO Error: Negative feature map values detected in keys"

        # 1. Compute summary context matrix KV = K_phi^T @ V -> [B, H, D, D]
        # Eliminates the N x N sequence dimension from intermediate tensor storage!
        kv = torch.matmul(k_phi.transpose(-2, -1), v)  # [B, H, D, D]

        # 2. Compute normalizer sum for exact probability density scaling: [B, H, N, 1]
        k_sum = k_phi.sum(dim=-2, keepdim=True)        # [B, H, 1, D]
        denom = torch.matmul(q_phi, k_sum.transpose(-2, -1)) + self.eps  # [B, H, N, 1]

        # 3. Compute numerator and scale: (Q_phi @ KV) / Denominator
        num = torch.matmul(q_phi, kv)                   # [B, H, N, D]
        out_attn = num / denom                         # [B, H, N, D]

        # Sanity Check 2: Confirm output dimension sequence alignment
        assert out_attn.shape == (B, H, N, D), f"Kernel Attention Output Shape Error: {list(out_attn.shape)}"

        # Reshape multi-head representations back to sequence layout
        context = out_attn.permute(0, 2, 1, 3).contiguous().view(B, N, C)
        out = self.norm(x + self.out_proj(context))
        return out


class LinearNOBlock(nn.Module):
    """
    LinearNO Operator Block: Couples Kernelized Linear Attention with
    a Feed-Forward Network and residual normalization.
    """
    def __init__(self, embed_dim, heads=4):
        super().__init__()
        self.attn = KernelizedLinearAttention(embed_dim, heads=heads)
        self.ffn = nn.Sequential(
            nn.Linear(embed_dim, embed_dim * 2),
            nn.GELU(),
            nn.Linear(embed_dim * 2, embed_dim)
        )
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, x):
        attn_out = self.attn(x)
        ffn_out = self.ffn(attn_out)
        out = self.norm(attn_out + ffn_out)
        return out


class LinearNONet(nn.Module):
    """
    Linear Attention Neural Operator (LinearNO):
    Achieves pure O(N) linear time and memory scaling using kernel feature mapping.
    """
    def __init__(self, node_in_channels=1, hidden_channels=64, out_channels=1, num_layers=3, heads=4):
        super().__init__()
        self.hidden_channels = hidden_channels

        self.lifting = nn.Linear(node_in_channels, hidden_channels)

        self.layers = nn.ModuleList([
            LinearNOBlock(embed_dim=hidden_channels, heads=heads)
            for _ in range(num_layers)
        ])

        self.projection = nn.Sequential(
            nn.Linear(hidden_channels, hidden_channels),
            nn.GELU(),
            nn.Linear(hidden_channels, out_channels)
        )

    def forward(self, inputs):
        assert isinstance(inputs, (tuple, list)) and len(inputs) == 2, \
            "LinearNONet Error: Inputs must be formatted as (x_branch, x_trunk)"

        x_branch, x_trunk = inputs

        if isinstance(x_branch, np.ndarray): x_branch = torch.from_numpy(x_branch).float()
        if isinstance(x_trunk, np.ndarray): x_trunk = torch.from_numpy(x_trunk).float()

        device = next(self.parameters()).device
        x_branch = x_branch.to(device)
        x_trunk = x_trunk.to(device)

        B = x_branch.shape[0]
        N_nodes = x_trunk.shape[0]

        # 1. Lift scalar physical fields into embedded token space
        h = self.lifting(x_branch.unsqueeze(-1)) # [B, N_nodes, hidden_channels]

        # Sanity Check 1: Verify lifting feature dimensions
        assert h.shape == (B, N_nodes, self.hidden_channels), f"Lifting Error: Got shape {list(h.shape)}"

        # 2. Pass sequence through kernelized linear attention layers
        for layer in self.layers:
            h = layer(h)

        # Sanity Check 2: Verify feature shape stability across deep layers
        assert h.shape == (B, N_nodes, self.hidden_channels), f"LinearNO Layer Processing Error: {list(h.shape)}"

        # 3. Project hidden representations to predicted PDE scalar field
        out = self.projection(h).squeeze(-1) # [B, N_nodes]

        # Final Sanity Check: Confirm batch dimension alignment matches target output
        assert out.shape == (B, N_nodes), f"LinearNO Final Output Error: Shape mismatch {list(out.shape)}"
        return out

