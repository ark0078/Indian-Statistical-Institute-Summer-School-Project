class AxialMultiHeadAttention(nn.Module):
    """
    Computes 1D multi-head self-attention along a designated spatial axis (H or W).
    Reduces 2D spatial attention complexity from O((H*W)^2) to O(H*W^2 + W*H^2).
    """
    def __init__(self, embed_dim, heads=4):
        super().__init__()
        self.embed_dim = embed_dim
        self.heads = heads
        self.head_dim = embed_dim // heads

        assert self.head_dim * heads == embed_dim, "FactFormer Error: embed_dim must be cleanly divisible by heads count"

        self.q_proj = nn.Linear(embed_dim, embed_dim)
        self.k_proj = nn.Linear(embed_dim, embed_dim)
        self.v_proj = nn.Linear(embed_dim, embed_dim)
        self.out_proj = nn.Linear(embed_dim, embed_dim)

    def forward(self, x, axis=1):
        # x shape: [B, H, W, C]
        B, H, W, C = x.shape

        if axis == 1: # Attention along H (Height) axis
            # Reshape [B, H, W, C] -> [B * W, H, C]
            x_perm = x.permute(0, 2, 1, 3).reshape(B * W, H, C)
            seq_len = H
            batch_stride = B * W
        elif axis == 2: # Attention along W (Width) axis
            # Reshape [B, H, W, C] -> [B * H, W, C]
            x_perm = x.reshape(B * H, W, C)
            seq_len = W
            batch_stride = B * H
        else:
            raise ValueError(f"Invalid axis {axis} for 2D axial attention")

        q = self.q_proj(x_perm).view(batch_stride, seq_len, self.heads, self.head_dim).permute(0, 2, 1, 3) # [batch_stride, heads, seq_len, head_dim]
        k = self.k_proj(x_perm).view(batch_stride, seq_len, self.heads, self.head_dim).permute(0, 2, 1, 3)
        v = self.v_proj(x_perm).view(batch_stride, seq_len, self.heads, self.head_dim).permute(0, 2, 1, 3)

        scores = torch.matmul(q, k.transpose(-2, -1)) / (self.head_dim ** 0.5) # [batch_stride, heads, seq_len, seq_len]
        attn_weights = F.softmax(scores, dim=-1)

        context = torch.matmul(attn_weights, v) # [batch_stride, heads, seq_len, head_dim]
        context = context.permute(0, 2, 1, 3).contiguous().view(batch_stride, seq_len, C)
        out = self.out_proj(context)

        if axis == 1:
            out = out.view(B, W, H, C).permute(0, 2, 1, 3).contiguous() # [B, H, W, C]
        else:
            out = out.view(B, H, W, C).contiguous() # [B, H, W, C]

        assert out.shape == (B, H, W, C), f"Axial Attention Shape Mismatch: {list(out.shape)}"
        return out


class AxialFactorizedAttention2D(nn.Module):
    """
    FactFormer Axial Factorized Attention 2D Layer:
    Executes parallel or cascaded 1D attentions along orthogonal spatial dimensions (H and W)
    and merges them with channel-wise projection.
    """
    def __init__(self, embed_dim, heads=4):
        super().__init__()
        self.attn_h = AxialMultiHeadAttention(embed_dim, heads=heads)
        self.attn_w = AxialMultiHeadAttention(embed_dim, heads=heads)
        self.fuse_proj = nn.Linear(embed_dim * 2, embed_dim)
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, x):
        B, H, W, C = x.shape

        # Compute parallel axial factorized attentions along Height and Width axes
        out_h = self.attn_h(x, axis=1) # [B, H, W, C]
        out_w = self.attn_w(x, axis=2) # [B, H, W, C]

        # Concatenate factorized spatial features along channel axis and project
        fused = torch.cat([out_h, out_w], dim=-1) # [B, H, W, 2*C]
        out = self.norm(x + self.fuse_proj(fused)) # [B, H, W, C]

        assert out.shape == (B, H, W, C), f"FactFormer 2D Attention Shape Error: {list(out.shape)}"
        return out


class FactFormerBlock(nn.Module):
    """
    FactFormer Transformer Block: Axial factorized attention coupled with
    a pointwise feed-forward network and residual layer normalization.
    """
    def __init__(self, embed_dim, heads=4):
        super().__init__()
        self.axial_attn = AxialFactorizedAttention2D(embed_dim, heads=heads)
        self.ffn = nn.Sequential(
            nn.Linear(embed_dim, embed_dim * 2),
            nn.GELU(),
            nn.Linear(embed_dim * 2, embed_dim)
        )
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, x):
        B, H, W, C = x.shape
        attn_out = self.axial_attn(x)
        ffn_out = self.ffn(attn_out)
        out = self.norm(attn_out + ffn_out)

        assert out.shape == (B, H, W, C), f"FactFormer Block Shape Error: {list(out.shape)}"
        return out


class FactFormerNet(nn.Module):
    """
    Factorized Transformer (FactFormer) Operator Network:
    Decomposes multi-dimensional grid token matrices into factorized 1D axial attention paths
    to achieve low-rank high-efficiency PDE modeling.
    """
    def __init__(self, node_in_channels=1, hidden_channels=64, out_channels=1, num_layers=3, heads=4):
        super().__init__()
        self.hidden_channels = hidden_channels
        self.heads = heads

        self.lifting = nn.Linear(node_in_channels, hidden_channels)

        self.layers = nn.ModuleList([
            FactFormerBlock(embed_dim=hidden_channels, heads=heads)
            for _ in range(num_layers)
        ])

        self.projection = nn.Sequential(
            nn.Linear(hidden_channels, hidden_channels),
            nn.GELU(),
            nn.Linear(hidden_channels, out_channels)
        )

    def forward(self, inputs):
        assert isinstance(inputs, (tuple, list)) and len(inputs) == 2, \
            "FactFormerNet Pipeline Error: Expected baseline model parameters wrapped as (x_branch, x_trunk)"

        x_branch, x_trunk = inputs

        if isinstance(x_branch, np.ndarray): x_branch = torch.from_numpy(x_branch).float()
        if isinstance(x_trunk, np.ndarray): x_trunk = torch.from_numpy(x_trunk).float()

        device = next(self.parameters()).device
        x_branch = x_branch.to(device)
        x_trunk = x_trunk.to(device)

        B = x_branch.shape[0]
        N_nodes = x_trunk.shape[0]

        # Deduce 2D spatial grid resolution from flattened sequence node length
        H = int(np.round(np.sqrt(N_nodes)))
        W = H

        # Sanity Check 1: Verify square tensor grid resolution reconstruction
        assert H * W == N_nodes, f"FactFormer Resolution Error: N_nodes={N_nodes} is not a perfect square grid ({H}x{W})"

        # 1. Lift scalar physical fields into embedded token representation spaces
        h = self.lifting(x_branch.unsqueeze(-1)) # [B, N_nodes, hidden_channels]

        # Sanity Check 2: Confirm embedded tensor channel structure
        assert h.shape == (B, N_nodes, self.hidden_channels), f"Lifting Stage Error: Got shape {list(h.shape)}"

        # Reshape 1D node token sequence into 2D grid matrix layout: [B, N_nodes, C] -> [B, H, W, C]
        h_grid = h.view(B, H, W, self.hidden_channels)

        # 2. Process features through cascaded 2D axial factorized attention blocks
        for layer in self.layers:
            h_grid = layer(h_grid)

        # Sanity Check 3: Spatial grid resolution integrity check
        assert h_grid.shape == (B, H, W, self.hidden_channels), f"FactFormer Layer Processing Error: {list(h_grid.shape)}"

        # Flatten spatial grid matrix back to sequence layout: [B, H, W, C] -> [B, N_nodes, C]
        h_flat = h_grid.view(B, N_nodes, self.hidden_channels)

        # 3. Project hidden tokens back to scalar physical output values
        out = self.projection(h_flat).squeeze(-1) # [B, N_nodes]

        # Final Verification Check: Confirm batch dimension alignment matches target output
        assert out.shape == (B, N_nodes), f"FactFormer Final Output Error: Shape mismatch {list(out.shape)}"
        return out

