class GeometryEmbedding(nn.Module):
    """
    Extracts continuous statistical geometric descriptors from the grid topology
    to guarantee operator invariance across complex and irregular domains.
    """
    def __init__(self, coord_dim=2, emb_dim=32):
        super().__init__()
        self.coord_dim = coord_dim
        self.emb_dim = emb_dim
        self.mlp = nn.Sequential(
            nn.Linear(coord_dim + 1, emb_dim),
            nn.ReLU(),
            nn.Linear(emb_dim, emb_dim)
        )

    def forward(self, coords):
        # Shape Check: Input coordinates matrix must be 2D [Num_Nodes, Coordinate_Dimensions]
        assert coords.ndim == 2 and coords.shape[1] == self.coord_dim, \
            f"GeometryEmbedding Error: Expected input coordinates shape [N, {self.coord_dim}], got {list(coords.shape)}"

        num_nodes = coords.shape[0]

        # Calculate localized point-cloud spatial density using pairwise distance norms
        dists = torch.cdist(coords, coords)
        density = torch.mean(dists, dim=-1, keepdim=True)

        # Sanity Check: Ensure density descriptor matches node count dimension
        assert density.shape == (num_nodes, 1), \
            f"GeometryEmbedding Error: Density tensor shape mismatch. Got {list(density.shape)}, expected [{num_nodes}, 1]"

        geom_features = torch.cat([coords, density], dim=-1)
        out = self.mlp(geom_features)

        # Final Shape Check: Validate continuous channel embedding projection
        assert out.shape == (num_nodes, self.emb_dim), \
            f"GeometryEmbedding Error: Output feature matrix shape mismatch. Got {list(out.shape)}, expected [{num_nodes}, {self.emb_dim}]"
        return out


class MultiscaleAttentionalGNO(nn.Module):
    """
    MAGNO Layer: Maps discrete physical point fields into hidden token channels using
    radius-masked multiscale cross-attention and parametric scale-fusion networks.
    """
    def __init__(self, in_features, out_features, emb_dim=32, heads=4, radii=[0.15, 0.35, 0.65]):
        super().__init__()
        self.radii = radii
        self.heads = heads
        self.out_features = out_features
        self.emb_dim = emb_dim

        self.q_proj = nn.Linear(out_features, out_features * heads)
        self.k_proj = nn.Linear(in_features, out_features * heads)
        self.v_proj = nn.Linear(in_features, out_features * heads)

        self.edge_mlps = nn.ModuleList([
            nn.Sequential(
                nn.Linear(2 + emb_dim, out_features * heads),
                nn.ReLU(),
                nn.Linear(out_features * heads, heads)
            ) for _ in range(len(radii))
        ])

        # Broadcast Alignment: Shape explicitly set to [Scales, 1, Heads, 1, 1] to avoid batch size collisions
        self.fusion_weights = nn.Parameter(torch.ones(len(radii), 1, heads, 1, 1))
        self.out_proj = nn.Linear(out_features * heads, out_features)

    def forward(self, h_physical, physical_coords, h_latent_init, latent_coords, geom_emb):
        # Shape Check: Core continuous tensors entry verification
        B, N_phys, C_in = h_physical.shape
        _, N_lat, C_out = h_latent_init.shape

        assert physical_coords.shape == (N_phys, 2), f"MAGNO Input Error: physical_coords shape mismatch {list(physical_coords.shape)}"
        assert latent_coords.shape == (N_lat, 2), f"MAGNO Input Error: latent_coords shape mismatch {list(latent_coords.shape)}"
        assert geom_emb.shape == (N_lat, self.emb_dim), f"MAGNO Input Error: geom_emb shape mismatch {list(geom_emb.shape)}"

        # Compute continuous spatial spatial distributions
        dist_matrix = torch.cdist(latent_coords, physical_coords)  # [N_lat, N_phys]
        coord_diff = latent_coords.unsqueeze(1) - physical_coords.unsqueeze(0)  # [N_lat, N_phys, 2]

        geom_expanded = geom_emb.unsqueeze(1).expand(-1, N_phys, -1)  # [N_lat, N_phys, emb_dim]
        edge_input = torch.cat([coord_diff, geom_expanded], dim=-1)  # [N_lat, N_phys, 2 + emb_dim]

        # Project inputs to multi-head representation matrices
        q = self.q_proj(h_latent_init).view(B, N_lat, self.heads, self.out_features).permute(0, 2, 1, 3) # [B, H, N_lat, C]
        k = self.k_proj(h_physical).view(B, N_phys, self.heads, self.out_features).permute(0, 2, 1, 3)  # [B, H, N_phys, C]
        v = self.v_proj(h_physical).view(B, N_phys, self.heads, self.out_features).permute(0, 2, 1, 3)  # [B, H, N_phys, C]

        scale_outputs = []
        for idx, r in enumerate(self.radii):
            # Enforce multiscale localization via sparse neighborhood masking
            mask = (dist_matrix > r).unsqueeze(0).unsqueeze(1)  # [1, 1, N_lat, N_phys]
            edge_bias = self.edge_mlps[idx](edge_input).permute(2, 0, 1).unsqueeze(0)  # [1, H, N_lat, N_phys]

            # Attentional integration score evaluation
            attn = torch.matmul(q, k.transpose(-2, -1)) / (self.out_features ** 0.5)
            attn = attn + edge_bias
            attn = attn.masked_fill(mask, float('-inf'))
            attn_weights = F.softmax(attn, dim=-1)
            attn_weights = torch.nan_to_num(attn_weights, nan=0.0)

            scale_out = torch.matmul(attn_weights, v)  # [B, H, N_lat, C]
            scale_outputs.append(scale_out)

        stacked_scales = torch.stack(scale_outputs, dim=0)

        # Broadcast Guarantee Assertion: Validates that the scale dimension aligns cleanly over the batch dimension axis
        expected_stacked_shape = (len(self.radii), B, self.heads, N_lat, self.out_features)
        assert stacked_scales.shape == expected_stacked_shape, \
            f"MAGNO Internal Error: stacked_scales shape {list(stacked_scales.shape)} failed broadcast check for {list(expected_stacked_shape)}"

        normalized_fusion = F.softmax(self.fusion_weights, dim=0)
        fused_out = torch.sum(stacked_scales * normalized_fusion, dim=0)  # [B, H, N_lat, C]

        fused_out = fused_out.permute(0, 2, 1, 3).contiguous().view(B, N_lat, -1)
        out = self.out_proj(fused_out)

        # Final Shape Assertion
        assert out.shape == (B, N_lat, self.out_features), \
            f"MAGNO Output Error: Final layer state matrix mismatch. Got {list(out.shape)}, expected [{B}, {N_lat}, {self.out_features}]"
        return out


class TransformerProcessorBlock(nn.Module):
    """
    Vision Transformer layer deployed over the latent grid to process non-local global token relations.
    """
    def __init__(self, embed_dim, heads=4, dim_feedforward=128):
        super().__init__()
        self.embed_dim = embed_dim
        self.attn = nn.MultiheadAttention(embed_dim, heads, batch_first=True)
        self.linear1 = nn.Linear(embed_dim, dim_feedforward)
        self.linear2 = nn.Linear(dim_feedforward, embed_dim)
        self.norm1 = nn.LayerNorm(embed_dim)
        self.norm2 = nn.LayerNorm(embed_dim)

    def forward(self, x):
        # Shape Check: Input sequence validation
        assert x.ndim == 3 and x.shape[2] == self.embed_dim, \
            f"Transformer Error: Expected token matrix shape [B, N, {self.embed_dim}], got {list(x.shape)}"

        attn_out, _ = self.attn(x, x, x)
        x = self.norm1(x + attn_out)
        ff_out = self.linear2(F.relu(self.linear1(x)))
        out = self.norm2(x + ff_out)

        assert out.shape == x.shape, f"Transformer Error: Token spatial scale changed during layer processing: {list(out.shape)}"
        return out


class MAGNONet(nn.Module):
    """
    Full GAOT Model Framework linking MAGNO multi-scale graph tokenizers with core Latent Processors.
    """
    def __init__(self, node_in_channels=1, hidden_channels=64, out_channels=1, num_transformer_layers=2, heads=4):
        super().__init__()
        self.hidden_channels = hidden_channels

        self.geom_encoder = GeometryEmbedding(coord_dim=2, emb_dim=32)
        self.lifting = nn.Linear(node_in_channels, hidden_channels)

        self.magno_encoder = MultiscaleAttentionalGNO(
            in_features=hidden_channels, out_features=hidden_channels, emb_dim=32, heads=heads
        )
        self.processor = nn.ModuleList([
            TransformerProcessorBlock(embed_dim=hidden_channels, heads=heads)
            for _ in range(num_transformer_layers)
        ])
        self.magno_decoder = MultiscaleAttentionalGNO(
            in_features=hidden_channels, out_features=hidden_channels, emb_dim=32, heads=heads
        )
        self.projection = nn.Sequential(
            nn.Linear(hidden_channels, hidden_channels),
            nn.ReLU(),
            nn.Linear(hidden_channels, out_channels)
        )

    def forward(self, inputs):
        # Sanity Check: Ensure exact input configuration tuple packaging
        assert isinstance(inputs, (tuple, list)) and len(inputs) == 2, \
            "MAGNONet Pipeline Error: Model expects inputs wrapped precisely as a structural tuple (x_branch, x_trunk)"

        x_branch, x_trunk = inputs

        if isinstance(x_branch, np.ndarray): x_branch = torch.from_numpy(x_branch).float()
        if isinstance(x_trunk, np.ndarray): x_trunk = torch.from_numpy(x_trunk).float()

        device = next(self.parameters()).device
        x_branch = x_branch.to(device)
        x_trunk = x_trunk.to(device)

        B = x_branch.shape[0]
        N_nodes = x_trunk.shape[0]

        # 1. Project physical boundary properties into latent states
        h_phys = self.lifting(x_branch.unsqueeze(-1))
        assert h_phys.shape == (B, N_nodes, self.hidden_channels), f"Lifting Stage Shape Error: {list(h_phys.shape)}"

        # 2. Extract structural domain metrics
        geom_emb = self.geom_encoder(x_trunk)

        # 3. Initialize latent space states and execute MAGNO multiscale encoding
        h_latent_init = torch.zeros(B, N_nodes, self.hidden_channels, device=device)
        h_latent = self.magno_encoder(h_phys, x_trunk, h_latent_init, x_trunk, geom_emb)
        assert h_latent.shape == (B, N_nodes, self.hidden_channels), f"Encoder Stage Shape Error: {list(h_latent.shape)}"

        # 4. Process non-local field variables across deep sequence blocks
        for block in self.processor:
            h_latent = block(h_latent)

        # 5. Decode multiscale continuous fields back into physical values
        h_out = self.magno_decoder(h_latent, x_trunk, h_latent, x_trunk, geom_emb)
        assert h_out.shape == (B, N_nodes, self.hidden_channels), f"Decoder Stage Shape Error: {list(h_out.shape)}"

        out = self.projection(h_out).squeeze(-1)

        # Final Verification Check: Confirm batch predictions are accurately structured
        assert out.shape == (B, N_nodes), f"MAGNONet Final Output Mismatch: {list(out.shape)}"
        return out

