def create_grid(resolution):
    x = torch.linspace(0, 1, resolution)
    y = torch.linspace(0, 1, resolution)
    grid_x, grid_y = torch.meshgrid(x, y, indexing="ij")
    return torch.stack([grid_x.flatten(), grid_y.flatten()], dim=-1)

