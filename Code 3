def downsample_fields(x, y, size):
    if x.ndim == 3: x = x.unsqueeze(1)
    if y.ndim == 3: y = y.unsqueeze(1)
    x = F.interpolate(x.float(), size=(size, size), mode="bilinear", align_corners=False)
    y = F.interpolate(y.float(), size=(size, size), mode="bilinear", align_corners=False)
    return x, y

