class GeometricGatedFFN(nn.Module):
    """
    Geometric Gating Mechanism: Implements soft domain decomposition using a spatial
    coordinate-gated Feed-Forward Network (Mixture of Experts) to handle multi-scale details.
    """
    def __init__(self, embed_dim, hidden_dim, num_experts=4):
        super().__init__()
        self.embed_dim = embed_dim
        self.num_experts = num_experts

        # Gating network maps physical spatial coordinates to expert mixing weights
        self.gate_network = nn.Sequential(
            nn.Linear(2, 32),
            nn.ReLU(),
            nn.Linear(32, num_experts)
        )

        # Define parallel expert networks
        self.experts = nn.ModuleList([
            nn.Sequential(
                nn.Linear(embed_dim, hidden_dim),
                nn.ReLU(),
                nn.Linear(hidden_dim, embed_dim)
            ) for _ in range(num_experts)
        ])

    def forward(self, x, coords):
        # Shape Check: Token field representation vector and mesh coordinates verification
        B, N, C = x.shape
        assert coords.shape == (N, 2), f"Gating Error: Coordinate grid layout mismatch {list(coords.shape)}"

        # Compute expert distribution gates over spatial coordinates
        gate_logits = self.gate_network(coords) # [N, num_experts]
        gate_weights = F.softmax(gate_logits, dim=-1) # [N, num_experts]

        # Route input states through parallel expert pathways
        expert_outputs = []
        for expert in self.experts:
            expert_outputs.append(expert(x)) # List of [B, N, embed_dim]

        stacked_outputs = torch.stack(expert_outputs, dim=-1) # [B, N, embed_dim, num_experts]

        # Sanity Check 1: Confirm tensor structure dimensions before combining experts
        expected_stack = (B, N, self.embed_dim, self.num_experts)
        assert stacked_outputs.shape == expected_stack, \
            f"Gating Error: Stacked experts shape {list(stacked_outputs.shape)} != {list(expected_stack)}"

        # Blend expert computations based on local spatial gate coefficients
        gate_weights_expanded = gate_weights.unsqueeze(0).unsqueeze(2) # [1, N, 1, num_experts]
        fused_out = torch.sum(stacked_outputs * gate_weights_expanded, dim=-1) # [B, N, embed_dim]

        # Final Verification Check
        assert fused_out.shape == (B, N, C), f"Gating Error: Final out matrix dimension shift: {list(fused_out.shape)}"
        return fused_out


class HeterogeneousNormalizedAttention(nn.Module):
    """
    Processes diverse input function tokens and coordinates cleanly using multi-head attention blocks.
    """
    def __init__(self, embed_dim, heads=4):
        super().__init__()
        self.embed_dim = embed_dim
        self.heads = heads
        self.head_dim = embed_dim // heads

        assert self.head_dim * heads == embed_dim, "Attention Error: embed_dim must be cleanly divisible by heads count"

        self.q_proj = nn.Linear(embed_dim, embed_dim)
        self.k_proj = nn.Linear(embed_dim, embed_dim)
        self.v_proj = nn.Linear(embed_dim, embed_dim)

        self.out_proj = nn.Linear(embed_dim, embed_dim)
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, x):
        B, N, C = x.shape

        # Project inputs to multi-head subspace layers
        q = self.q_proj(x).view(B, N, self.heads, self.head_dim).permute(0, 2, 1, 3) # [B, H, N, D]
        k = self.k_proj(x).view(B, N, self.heads, self.head_dim).permute(0, 2, 1, 3) # [B, H, N, D]
        v = self.v_proj(x).view(B, N, self.heads, self.head_dim).permute(0, 2, 1, 3) # [B, H, N, D]

        # Compute dot-product attention maps
        scores = torch.matmul(q, k.transpose(-2, -1)) / (self.head_dim ** 0.5) # [B, H, N, N]
        attn_weights = F.softmax(scores, dim=-1)

        context = torch.matmul(attn_weights, v) # [B, H, N, D]
        context = context.permute(0, 2, 1, 3).contiguous().view(B, N, -1) # [B, N, C]

        out = self.norm(x + self.out_proj(context))

        # Final Dimension Verification
        assert out.shape == (B, N, C), f"Attention Error: Dimension shift triggered: {list(out.shape)}"
        return out


class GNOTBlock(nn.Module):
    """
    Combines the Heterogeneous Attention channels with the spatial coordinate Geometric Gated FFN layers.
    """
    def __init__(self, embed_dim, heads=4, num_experts=4):
        super().__init__()
        self.attn = HeterogeneousNormalizedAttention(embed_dim, heads)
        self.gated_ffn = GeometricGatedFFN(embed_dim, hidden_dim=embed_dim * 2, num_experts=num_experts)
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, x, coords):
        # 1. Evaluate spatial field contextual cross-attention updates
        attn_out = self.attn(x)

        # 2. Update representations using the coordinate mixture-of-experts gating pass
        fused_out = self.gated_ffn(attn_out, coords)

        # Apply residual layer normalization step
        out = self.norm(attn_out + fused_out)
        return out


class GNOTNet(nn.Module):
    """
    Full GNOT Framework connecting functional lifts, multi-head attention arrays,
    and geometric routing gates.
    """
    def __init__(self, node_in_channels=1, hidden_channels=64, out_channels=1, num_layers=3, heads=4, num_experts=4):
        super().__init__()
        self.hidden_channels = hidden_channels

        # Project sparse physical variables into continuous feature spaces
        self.lifting = nn.Linear(node_in_channels, hidden_channels)

        # Instantiate cascaded GNOT processing layers
        self.layers = nn.ModuleList([
            GNOTBlock(embed_dim=hidden_channels, heads=heads, num_experts=num_experts)
            for _ in range(num_layers)
        ])

        # Output field prediction projection layer
        self.projection = nn.Sequential(
            nn.Linear(hidden_channels, hidden_channels),
            nn.ReLU(),
            nn.Linear(hidden_channels, out_channels)
        )

    def forward(self, inputs):
        # Sanity Check 2: Confirm input tuple structure matches pipeline design
        assert isinstance(inputs, (tuple, list)) and len(inputs) == 2, \
            "GNOTNet Pipeline Error: Expected baseline model parameters wrapped as (x_branch, x_trunk)"

        x_branch, x_trunk = inputs

        if isinstance(x_branch, np.ndarray): x_branch = torch.from_numpy(x_branch).float()
        if isinstance(x_trunk, np.ndarray): x_trunk = torch.from_numpy(x_trunk).float()

        device = next(self.parameters()).device
        x_branch = x_branch.to(device)
        x_trunk = x_trunk.to(device)

        B = x_branch.shape[0]
        N_nodes = x_trunk.shape[0]

        # 1. Continuous lifting layer pass
        h = self.lifting(x_branch.unsqueeze(-1)) # [B, N_nodes, hidden_channels]

        # Sanity Check 3: Confirm mapping dimension layout matches hidden settings
        assert h.shape == (B, N_nodes, self.hidden_channels), f"Lifting Stage Error: Got shape {list(h.shape)}"

        # 2. Route states through the GNOT attention block pipeline
        for layer in self.layers:
            h = layer(h, x_trunk)

        # Sanity Check 4: Confirm spatial tensor resolution is maintained post-attention processing
        assert h.shape == (B, N_nodes, self.hidden_channels), f"Processing Error: Context shape altered to {list(h.shape)}"

        # 3. Project hidden tokens back into target scale prediction shapes
        out = self.projection(h).squeeze(-1) # [B, N_nodes]

        # Final Verification Check: Confirm batch dimension alignment matches target matrix
        assert out.shape == (B, N_nodes), f"GNOTNet Final Output Error: Matrix shape mismatch: {list(out.shape)}"
        return out

