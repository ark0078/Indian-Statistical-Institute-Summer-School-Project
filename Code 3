                pred = net((batch_x, grid_tensor))

                # Sanity Check 3: Output tensor dimension synchronization check
                assert pred.shape == batch_y.shape, \
                    f"Loss Engine Dimension Collision: Pred {list(pred.shape)} != Target {list(batch_y.shape)}"

                loss = criterion(pred, batch_y)
                loss.backward()
                optimizer.step()

                total_train_loss += loss.item() * current_batch_size

            avg_train_loss = total_train_loss / len(train_loader.dataset)

            # Validation Evaluation Step
            net.eval()
            total_test_loss = 0.0
            total_test_l2 = 0.0

            with torch.no_grad():
                for batch_x, batch_y in test_loader:
                    batch_x, batch_y = batch_x.to(device), batch_y.to(device)

                    pred = net((batch_x, grid_tensor))

                    loss = criterion(pred, batch_y)
                    total_test_loss += loss.item() * batch_x.size(0)

                    # Compute Relative L2 error deviation
                    l2_err = torch.norm(pred - batch_y) / torch.norm(batch_y)
                    total_test_l2 += l2_err.item() * batch_x.size(0)

            avg_test_loss = total_test_loss / len(test_loader.dataset)
            avg_test_l2 = total_test_l2 / len(test_loader.dataset)

            steps_hist.append(epoch)
            train_loss_hist.append(avg_train_loss)
            test_loss_hist.append(avg_test_loss)
            test_metric_hist.append(avg_test_l2)

            if epoch % max(1, epochs // 5) == 0 or epoch == epochs:
                print(f"Epoch {epoch:03d}/{epochs:03d} | Train MSE: {avg_train_loss:.6f} | Test MSE: {avg_test_loss:.6f} | Relative L2: {avg_test_l2:.6f}")

