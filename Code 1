print(f"Total Batches -> Train: {len(train_loader)} | Test: {len(test_loader)}")class MultiParticleDualAttention(nn.Module):
    """
    MPNOT Multi-Particle Attention with Pairwise Diffusion Distance Decay.
    Combines feature dot-product similarity with spatial diffusion decay gamma * ||x_i - x_j||^2.
    """
    def __init__(self, embed_dim, heads=4):
        super().__init__()
        self.embed_dim = embed_dim
        self.heads = heads
        self.head_dim = embed_dim // heads

        assert self.head_dim * heads == embed_dim, "MPNOT Error: embed_dim must be divisible by heads"

        self.q_proj = nn.Linear(embed_dim, embed_dim)
        self.k_proj = nn.Linear(embed_dim, embed_dim)
        self.v_proj = nn.Linear(embed_dim, embed_dim)
        self.out_proj = nn.Linear(embed_dim, embed_dim)

        # Learnable spatial diffusion interaction parameter gamma
        self.gamma = nn.Parameter(torch.tensor([0.1], dtype=torch.float32))

    def forward(self, x, coords):
        # x shape: [B, N, C]
        # coords shape: [N, 2]
        B, N, C = x.shape
        H = self.heads
        D = self.head_dim

        # 1. Compute pairwise squared Euclidean diffusion distance matrix D_ij = ||x_i - x_j||^2
        diff = coords.unsqueeze(0) - coords.unsqueeze(1) # [N, N, 2]
        dist_sq = torch.sum(diff ** 2, dim=-1)           # [N, N]

        # 2. Project Q, K, V
        q = self.q_proj(x).view(B, N, H, D).permute(0, 2, 1, 3) # [B, H, N, D]
        k = self.k_proj(x).view(B, N, H, D).permute(0, 2, 1, 3) # [B, H, N, D]
        v = self.v_proj(x).view(B, N, H, D).permute(0, 2, 1, 3) # [B, H, N, D]

        # 3. Compute dot-product affinity scaled by head dimension
        scores = torch.matmul(q, k.transpose(-2, -1)) / (D ** 0.5) # [B, H, N, N]

        # 4. Inject MPNOT particle spatial diffusion decay term: - gamma * ||x_i - x_j||^2
        diffusion_decay = torch.abs(self.gamma) * dist_sq.unsqueeze(0).unsqueeze(0) # [1, 1, N, N]
        scores = scores - diffusion_decay

        # 5. Normalize interaction probabilities across particles
        attn_weights = F.softmax(scores, dim=-1) # [B, H, N, N]

        # 6. Aggregate particle states
        context = torch.matmul(attn_weights, v) # [B, H, N, D]
        context = context.permute(0, 2, 1, 3).contiguous().view(B, N, C)
        out = self.out_proj(context)

        assert out.shape == (B, N, C), f"MPNOT Attention Output Error: {list(out.shape)}"
        return out


class DualEmbeddingMPNOTBlock(nn.Module):
    """
    Dual-Embedding MPNOT Block:
    Processes features through Multi-Particle Diffusion Attention and Feed-Forward Networks.
    """
    def __init__(self, embed_dim, heads=4):
        super().__init__()
        self.mp_attn = MultiParticleDualAttention(embed_dim, heads=heads)
        self.ffn = nn.Sequential(
            nn.Linear(embed_dim, embed_dim * 2),
            nn.GELU(),
            nn.Linear(embed_dim * 2, embed_dim)
        )
        self.norm1 = nn.LayerNorm(embed_dim)
        self.norm2 = nn.LayerNorm(embed_dim)

    def forward(self, x, coords):
        attn_out = self.mp_attn(x, coords)
        x = self.norm1(x + attn_out)
        ffn_out = self.ffn(x)
        out = self.norm2(x + ffn_out)
        return out


class DualEmbeddingMPNOTNet(nn.Module):
    """
    Dual-Embedding Multi-Particle Neural Operator Transformer (Dual-MPNOT):
    Splits field values and mesh coordinates into distinct embedding halves,
    then processes them via MPNOT reaction-diffusion particle attention.
    """
    def __init__(self, node_in_channels=1, hidden_channels=64, out_channels=1, num_layers=3, heads=4):
        super().__init__()
        self.hidden_channels = hidden_channels
        self.half_dim = hidden_channels // 2

        assert self.half_dim * 2 == hidden_channels, "Hidden channels must be divisible by 2 for dual-embedding split"

        # Split 1: Physical scalar field embedding projection (d/2)
        self.field_embedding = nn.Linear(node_in_channels, self.half_dim)
        # Split 2: Spatial coordinate geometry embedding projection (d/2)
        self.spatial_embedding = nn.Linear(2, self.half_dim)

        # Cascaded MPNOT blocks
        self.layers = nn.ModuleList([
            DualEmbeddingMPNOTBlock(embed_dim=hidden_channels, heads=heads)
            for _ in range(num_layers)
        ])

        self.projection = nn.Sequential(
            nn.Linear(hidden_channels, hidden_channels),
            nn.GELU(),
            nn.Linear(hidden_channels, out_channels)
        )

    def forward(self, inputs):
        assert isinstance(inputs, (tuple, list)) and len(inputs) == 2, \
            "Dual-MPNOT Error: Inputs must be formatted as (x_branch, x_trunk)"

        x_branch, x_trunk = inputs

        if isinstance(x_branch, np.ndarray): x_branch = torch.from_numpy(x_branch).float()
        if isinstance(x_trunk, np.ndarray): x_trunk = torch.from_numpy(x_trunk).float()

        device = next(self.parameters()).device
        x_branch = x_branch.to(device)
        x_trunk = x_trunk.to(device)

        B = x_branch.shape[0]
        N_nodes = x_trunk.shape[0]

        # 1. Compute Half 1: Field embedding [B, N_nodes, d/2]
        h_field = self.field_embedding(x_branch.unsqueeze(-1))

        # 2. Compute Half 2: Spatial geometry embedding [1, N_nodes, d/2] -> expanded to [B, N_nodes, d/2]
        h_spatial = self.spatial_embedding(x_trunk).unsqueeze(0).expand(B, -1, -1)

        # Sanity Check 1: Verify exact half-split embedding shapes
        assert h_field.shape == (B, N_nodes, self.half_dim)
        assert h_spatial.shape == (B, N_nodes, self.half_dim)

        # 3. Concatenate dual embedding spaces into full hidden state [B, N_nodes, d]
        h = torch.cat([h_field, h_spatial], dim=-1)

        # Sanity Check 2: Confirm combined embedding channels match hidden_channels
        assert h.shape == (B, N_nodes, self.hidden_channels), f"Embedding Concatenation Error: {list(h.shape)}"

        # 4. Pass through MPNOT particle interaction blocks
        for layer in self.layers:
            h = layer(h, x_trunk)

        # 5. Final projection to output PDE solution field
        out = self.projection(h).squeeze(-1) # [B, N_nodes]

        # Final Verification Check: Confirm shape alignment
        assert out.shape == (B, N_nodes), f"Dual-MPNOT Final Output Error: Shape mismatch {list(out.shape)}"
        return out

